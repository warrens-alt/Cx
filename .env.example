# Server-only configuration. Do not put credentials into VITE_* variables or commit real values.
PORT=3000
NODE_ENV=development
# Bind development locally; deploy behind HTTPS and Google Cloud IAP.
HOST=127.0.0.1
APP_ORIGIN=https://your-protected-application.example
# Exact IAP resource audience (not an arbitrary application URL).
IAP_AUDIENCE=
# Verified identity -> exact tenant grants. No wildcard tenant or unauthenticated bypass.
# Example: {"analyst@example.com":{"tenants":["default_tenant"],"role":"viewer"}}
CX_ACCESS_POLICY_JSON={}
# Prefer workload identity / application default credentials. Optional local credential path:
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_MAX_BYTES_BILLED=1000000000
# Set only after confirming which source field represents incurred spend. Never assume budget.
BIGQUERY_MEDIA_SPEND_FIELD=
ALLOW_RAW_EXPORTS=false
ENABLE_AI_EXPLANATIONS=false
GEMINI_API_KEY=
